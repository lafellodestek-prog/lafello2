# Sunucunun calisacagi port (varsayilan 3000; Render kendisi verir)
PORT=3000
# Veritabani dosyasinin yeri (bos birakilirsa data/sahne.db)
DB_PATH=
# Canli sunucuda yonetim panelinin ilk sifresi (panel yalniz bir kez, sifre yokken kullanir)
ADMIN_PASSWORD=
# Veritabani yedegi icin Supabase proje adresi ve gizli anahtari (service_role).
# Bos birakilirsa yedekleme kapali olur (kendi bilgisayarinda calisirken gerek yok).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Mobil internette goruntu baglantisi icin aktarma sunucusu (TURN). Ikisinden birini kullan:
# 1) Cloudflare Realtime TURN anahtari
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
# 2) Herhangi bir TURN sunucusu (virgulle ayrilmis adresler)
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# Android uygulamasina bildirim icin Firebase hizmet hesabi (indirilen JSON dosyasinin tamami, tek satir).
# Bos birakilirsa yalniz tarayici bildirimleri calisir.
FCM_SERVICE_ACCOUNT=
